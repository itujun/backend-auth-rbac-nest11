NODE_ENV=development
PORT=3000

# Harus match dengan kredensial di docker-compose.yml
DATABASE_URL=jenisdb://user:pass@host:port/nama_db

# Generate secret sendiri, contoh: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# JANGAN pernah pakai secret contoh di bawah ini untuk production
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_hex_string_before_running
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token

# Origin frontend Svelte (untuk CORS + cookie)
CORS_ORIGIN=http://localhost:5173

# Opsional — dipakai oleh `npm run db:seed` untuk promote user ini jadi
# superadmin. Register user ini dulu lewat POST /auth/register, baru
# jalankan seed.
SEED_ADMIN_EMAIL=

# Folder penyimpanan file upload (avatar), relatif dari root project.
UPLOAD_DIR=uploads

# Swagger docs di /api/docs. Opsional — kalau dikosongkan, defaultnya
# aktif di semua environment SELAIN production (lihat configuration.ts).
# ENABLE_SWAGGER=true

# Rate limiting global (per IP). Endpoint sensitif (login/register/refresh)
# punya limit sendiri yang lebih ketat, hardcoded di auth.controller.ts.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Logging (nestjs-pino). Opsional — default mengikuti NODE_ENV:
# debug+pretty di development, info+JSON mentah di production.
# LOG_LEVEL=debug
# LOG_PRETTY=true

NODE_ENV=development
PORT=3000

# Harus match dengan kredensial di docker-compose.yml
DATABASE_URL=jenisdb://user:pass@host:port/nama_db

# Generate secret sendiri, contoh: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# JANGAN pernah pakai secret contoh di bawah ini untuk production
JWT_ACCESS_SECRET=change_this_to_a_random_64_char_hex_string_before_running
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_COOKIE_NAME=refresh_token

FRONTEND_URL=http://localhost:5173

EMAIL_VERIFICATION_TOKEN_EXPIRES_IN=24h

# Origin frontend Svelte (untuk CORS + cookie)
CORS_ORIGIN=http://localhost:5173

# Opsional — dipakai oleh `npm run db:seed` untuk promote user ini jadi
# superadmin. Register user ini dulu lewat POST /auth/register, baru
# jalankan seed.
SEED_ADMIN_EMAIL=

# Folder untuk DEFAULT avatar saja (asset yang dibundel bersama source
# code) -- BUKAN tempat avatar upload user, yang sejak migrasi ke
# Cloudflare R2 disimpan di object storage (lihat variabel R2_* di bawah),
# bukan filesystem container.
UPLOAD_DIR=uploads

# Redis (cache-aside untuk permission checks). Harus match kredensial
# service `redis` di docker-compose.yml. Semua opsional -- kalau
# dikosongkan, aplikasi tetap jalan normal (fallback full ke DB query,
# lihat komentar RedisModule & AuthorizationService).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=rbac:
# TTL cache permission (detik) -- jaring pengaman kalau ada invalidation
# yang terlewat. Invalidation eksplisit tetap mekanisme utama.
REDIS_PERMISSIONS_TTL_SECONDS=300

# Swagger docs di /api/docs. Opsional — kalau dikosongkan, defaultnya
# aktif di semua environment SELAIN production (lihat configuration.ts).
# ENABLE_SWAGGER=true

# Rate limiting global (per IP). Endpoint sensitif (login/register/refresh)
# punya limit sendiri yang lebih ketat, hardcoded di auth.controller.ts.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Logging (nestjs-pino). Opsional — default mengikuti NODE_ENV:
# debug+pretty di development, info+JSON mentah di production.
# LOG_LEVEL=debug
# LOG_PRETTY=true

# Cloudflare R2 (object storage S3-compatible untuk avatar upload user).
# Setup: Cloudflare Dashboard -> R2 Object Storage -> Create bucket ->
# Settings -> Public Access -> aktifkan "R2.dev subdomain" (jadi
# R2_PUBLIC_URL) -> "Manage R2 API Tokens" -> Create API Token dengan
# permission "Object Read & Write", scope dibatasi ke bucket ini saja.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=rbac-avatars
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# Telegram Bot API (notifikasi admin saat ada registrasi user baru).
# Setup:
#   1. Chat @BotFather di Telegram -> /newbot -> ikuti instruksi ->
#      salin token yang diberikan (format: 123456789:AA...).
#   2. Cari tahu chat ID kamu sendiri: chat @userinfobot, dia balas
#      chat ID kamu langsung. (Alternatif manual: kirim pesan apa saja
#      ke bot yang baru dibuat, lalu buka
#      https://api.telegram.org/bot<TOKEN>/getUpdates di browser, cari
#      field "chat":{"id": ...}).
#   3. Validasi manual sebelum jalankan aplikasi:
#      https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>&text=Halo
#      Kalau pesan masuk ke Telegram, konfigurasi sudah benar.
TELEGRAM_BOT_TOKEN=...
TELEGRAM_ADMIN_CHAT_ID=...

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM="Access Console" <no-reply@access-console.local>

PASSWORD_RESET_TOKEN_EXPIRES_IN=30m